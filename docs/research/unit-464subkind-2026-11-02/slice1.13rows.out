ROW  unit-464cure3-2026-11-01/grade-the-attrib-cure.mjs:186  id=GLIFT2  HIS-subkind5=conjunctive  HIS-reach=source-derived
     HIS-figure: existence of three named buckets in two separately-lifted DECLARED arrays
     HIS-states: preDecl:frozen vs Array literal; postDecl:live vs Array literal; bucket(preDecl,'header'):frozen vs key literal; bucket(preDecl,'pop-flag'):frozen vs key literal; bucket(postDecl,'pop-flag'):live vs key literal
====================================================================================================
 172    
 173    // ------------------------------------------------------------------- the capacity census (§2 below)
 174    // Computed HERE, above the gate print, because `GLIFT2` is a gate: in drive1 it was registered
 175    // after `gatesOk` had already been taken, so it counted in the summary line and refused nothing.
 176    // [[feedback_a_printed_self_test_that_gates_nothing]]
 177    const lift = (src) => {
 178      const s = src.indexOf('const DECLARED = [');
 179      const e = src.indexOf('\n];', s);
 180      if (s < 0 || e < s) return null;
 181      try { return new Function('return ' + src.slice(s + 'const DECLARED = '.length, e + 3).replace(/;$/, ''))(); }
 182      catch { return null; }
 183    };
 184    const [preDecl, postDecl] = [lift(preSrc), lift(postSrc)];
 185    const bucket = (decl, key) => (decl ?? []).find((d) => d.key === key);
 186 >> check('GLIFT2',
 187      Array.isArray(preDecl) && Array.isArray(postDecl)
 188      && !!bucket(preDecl, 'header') && !!bucket(preDecl, 'pop-flag') && !!bucket(postDecl, 'pop-flag'),
 189      `both DECLARED arrays lift and evaluate, and the censused buckets exist: PRE ` +
 190      `[${(preDecl ?? []).map((d) => d.key).join(',')}] · POST [${(postDecl ?? []).map((d) => d.key).join(',')}]`);

